# Copy this file to .env.test and fill in your local values.
# Variable names are identical to the secrets used in
# .github/workflows/backend-container.yml so the same credentials work locally.

DBSERVERADDRESS=localhost
DBNAME=your_db_name
DBUSER=your_db_user
DBPASSWORD=your_db_password

# Optional — defaults to Warning
LOG_LEVEL=Warning
