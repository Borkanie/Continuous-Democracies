{
  "name": "Go Development",
  "settings": "{\n  // --- Editor ---\n  \"editor.formatOnSave\": true,\n  \"editor.formatOnPaste\": false,\n  \"editor.tabSize\": 4,\n  \"editor.insertSpaces\": false,\n  \"editor.rulers\": [100],\n  \"editor.inlayHints.enabled\": \"on\",\n  \"editor.suggest.preview\": true,\n  \"editor.minimap.enabled\": false,\n  \"files.trimTrailingWhitespace\": true,\n  \"files.insertFinalNewline\": true,\n\n  // --- Go: toolchain ---\n  \"go.useLanguageServer\": true,\n  \"go.toolsManagement.autoUpdate\": true,\n  \"go.formatTool\": \"goimports\",\n  \"go.lintTool\": \"staticcheck\",\n  \"go.lintOnSave\": \"package\",\n  \"go.vetOnSave\": \"package\",\n  \"go.buildOnSave\": \"package\",\n  \"go.testOnSave\": false,\n  \"go.coverOnSave\": false,\n\n  // --- Go: inlay hints (shows types inline, helpful coming from Java) ---\n  \"go.inlayHints.assignVariableTypes\": true,\n  \"go.inlayHints.compositeLiteralFields\": true,\n  \"go.inlayHints.compositeLiteralTypes\": true,\n  \"go.inlayHints.constantValues\": true,\n  \"go.inlayHints.functionTypeParameters\": true,\n  \"go.inlayHints.parameterNames\": true,\n  \"go.inlayHints.rangeVariableTypes\": true,\n\n  // --- Go: gopls language server settings ---\n  \"gopls\": {\n    \"ui.completion.usePlaceholders\": true,\n    \"ui.diagnostic.staticcheck\": true,\n    \"ui.documentation.hoverKind\": \"FullDocumentation\",\n    \"ui.inlayhint.hints\": {\n      \"assignVariableTypes\": true,\n      \"compositeLiteralFields\": true,\n      \"compositeLiteralTypes\": true,\n      \"constantValues\": true,\n      \"functionTypeParameters\": true,\n      \"parameterNames\": true,\n      \"rangeVariableTypes\": true\n    }\n  },\n\n  // --- Go: test output ---\n  \"go.testFlags\": [\"-v\", \"-count=1\"],\n  \"go.showTestCodeLens\": true,\n\n  // --- Go: file associations ---\n  \"[go]\": {\n    \"editor.defaultFormatter\": \"golang.go\",\n    \"editor.formatOnSave\": true,\n    \"editor.codeActionsOnSave\": {\n      \"source.organizeImports\": \"explicit\"\n    }\n  },\n  \"[go.mod]\": {\n    \"editor.defaultFormatter\": \"golang.go\",\n    \"editor.formatOnSave\": true\n  },\n\n  // --- Terminal ---\n  \"terminal.integrated.defaultProfile.osx\": \"zsh\",\n\n  // --- Git ---\n  \"git.autofetch\": true,\n  \"gitlens.hovers.currentLine.over\": \"line\"\n}",
  "extensions": "[{\"identifier\":{\"id\":\"golang.go\"},\"displayName\":\"Go\"},{\"identifier\":{\"id\":\"mongodb.mongodb-vscode\"},\"displayName\":\"MongoDB for VS Code\"},{\"identifier\":{\"id\":\"eamodio.gitlens\"},\"displayName\":\"GitLens\"},{\"identifier\":{\"id\":\"humao.rest-client\"},\"displayName\":\"REST Client\"},{\"identifier\":{\"id\":\"streetsidesoftware.code-spell-checker\"},\"displayName\":\"Code Spell Checker\"},{\"identifier\":{\"id\":\"EditorConfig.EditorConfig\"},\"displayName\":\"EditorConfig for VS Code\"},{\"identifier\":{\"id\":\"ms-azuretools.vscode-docker\"},\"displayName\":\"Docker\"},{\"identifier\":{\"id\":\"mtxr.sqltools\"},\"displayName\":\"SQLTools\"}]"
