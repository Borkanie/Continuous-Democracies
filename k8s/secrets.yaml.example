# Copy to secrets.yaml, fill in values (base64-encoded), and apply before other manifests.
# NEVER commit secrets.yaml to git.
#
# To encode: echo -n "your-value" | base64
apiVersion: v1
kind: Secret
metadata:
  name: parliament-secrets
type: Opaque
data:
  openai-api-key: <base64-encoded-openai-key>
  cdep-proxy-url: ""   # optional: base64-encoded SOCKS5 URL (leave "" if unused)
