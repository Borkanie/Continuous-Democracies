{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Run server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/new-backend/api/cmd/server",
      "env": {
        "MONGODB_URI": "mongodb://localhost:27017",
        "DB_NAME": "parliamentdb",
        "PORT": "8080",
        "LOG_LEVEL": "debug"
      },
      "showLog": true
    },
    {
      "name": "API: Debug current test file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "showLog": true
    },
    {
      "name": "API: Debug specific test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/new-backend/api",
      "args": ["-run", "${input:testName}", "./..."],
      "showLog": true
    },
    {
      "name": "Scraper: Run one cycle",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/new-backend/scraper/cmd/scraper",
      "env": {
        "MONGODB_URI": "mongodb://localhost:27017",
        "DB_NAME": "parliamentdb",
        "OPENAI_API_KEY": "",
        "LOG_LEVEL": "debug",
        "RUN_ONCE": "true"
      },
      "showLog": true
    },
    {
      "name": "Integration tests: Run all",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/tests/integration",
      "args": ["-v", "-timeout", "120s"],
      "showLog": true
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Test function name to run (e.g. TestGetAllRounds_ReturnsAll)"
    }
  ]
}
